{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pencil-booking",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "workers_dev": true,
  "routes": [
    { "pattern": "mybookable.co.uk", "custom_domain": true },
    { "pattern": "www.mybookable.co.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/blog", "/blog/*", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pencil-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
